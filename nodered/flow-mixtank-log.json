[
    {
        "id": "mixtank-mqtt-in",
        "type": "mqtt in",
        "z": "mixtank-log-flow",
        "name": "MixTank Log MQTT",
        "topic": "MixTankFertilizerController/log/#",
        "qos": "0",
        "datatype": "auto",
        "broker": "mqtt-broker-config",
        "nl": false,
        "rap": false,
        "rh": 0,
        "x": 160,
        "y": 200,
        "wires": [["mixtank-set-filename"]]
    },
    {
        "id": "mixtank-set-filename",
        "type": "function",
        "z": "mixtank-log-flow",
        "name": "Set filename",
        "func": "msg.filename = \"/opt/nodered-logs/MixTank/log\";\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 200,
        "wires": [["mixtank-file-append"]]
    },
    {
        "id": "mixtank-file-append",
        "type": "file",
        "z": "mixtank-log-flow",
        "name": "Append to log",
        "filename": "",
        "filenameType": "msg",
        "appendNewline": true,
        "createDir": true,
        "overwriteFile": "false",
        "encoding": "utf8",
        "x": 610,
        "y": 200,
        "wires": [[]]
    },
    {
        "id": "mqtt-broker-config",
        "type": "mqtt-broker",
        "name": "MQTT Broker",
        "broker": "localhost",
        "port": "1883",
        "clientid": "nodered-mixtank-log",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "birthMsg": {},
        "closeTopic": "",
        "closeQos": "0",
        "closePayload": "",
        "closeMsg": {},
        "willTopic": "",
        "willQos": "0",
        "willPayload": "",
        "willMsg": {},
        "userProps": "",
        "sessionExpiry": ""
    },
    {
        "id": "mixtank-log-flow",
        "type": "tab",
        "label": "MixTank Log",
        "disabled": false,
        "info": "Prenumererar på MQTT-topic MixTankFertilizerController/log/# och sparar meddelanden till /opt/nodered-logs/MixTank/log"
    }
]
